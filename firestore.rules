rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FISHTRACK-SA — TACTICAL RULES v2 (matches current app, no auth)
    // Date: 2026-05-05
    // Why: app does not yet authenticate users. These rules are deliberately
    //      permissive so real users can keep logging catches.

    function isValidCatchLite() {
      let d = request.resource.data;
      return d.species is string && d.species.size() > 0
          && d.weight is number && d.weight >= 0 && d.weight < 1000
          && d.catcherName is string && d.catcherName.size() > 0
                                     && d.catcherName.size() <= 100;
    }

    match /catches/{catchId} {
      allow read: if true;
      allow create: if isValidCatchLite();
      allow update: if isValidCatchLite();
      allow delete: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /species/{id}    { allow read, write: if true; }
    match /settings/{id}   { allow read: if true; allow write: if false; }
    match /statistics/{id} { allow read: if true; allow write: if false; }
    match /leaderboard/{id}{ allow read: if true; allow write: if false; }

    match /reports/{id} {
      allow read: if false;
      allow create: if true;
    }
    match /admins/{id} { allow read, write: if false; }

    // DERBY ENGINE v2 (2026-09-16) — Gansbaai Galjoen Derby and onward.
    // Requires anonymous auth. Derby config docs are created via Firebase
    // Console only; adminUids in the config doc gates verification writes.

    function signedIn() {
      return request.auth != null;
    }

    function isDerbyAdmin(derbyId) {
      return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/derbies/$(derbyId)).data.adminUids;
    }

    match /derbies/{derbyId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isDerbyAdmin(derbyId);

      match /entries/{entryId} {
        allow read: if true;
        allow create: if signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 100
            && request.resource.data.entryType in ['individual', 'team'];
        allow update, delete: if isDerbyAdmin(derbyId);
      }

      match /catches/{catchId} {
        allow read: if true;
        allow create: if signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.anglerName is string
            && request.resource.data.anglerName.size() >= 2
            && request.resource.data.anglerName.size() <= 100
            && request.resource.data.species is string
            && request.resource.data.species.size() > 0
            && request.resource.data.spanCm is number
            && request.resource.data.spanCm > 0
            && request.resource.data.spanCm < 250
            && request.resource.data.photo is string
            && request.resource.data.photo.size() > 100;
        allow update: if isDerbyAdmin(derbyId);
        allow delete: if isDerbyAdmin(derbyId);
      }
    }


    // WOLK SOLUTIONS — invoice-control demo (2026-09-17). Separate collections,
    // does not touch FishTrack rules above. Invoices are captured by the WhatsApp
    // bot via the Admin SDK (bypasses rules); the office board reads them and may
    // only flip status/decidedAt while signed in (anonymous auth).
    match /wolkSuppliers/{tenant} {
      allow read: if true;
      allow write: if false;
    }
    // Slips captured directly from the browser (slip-capture.html) are created
    // client-side under anonymous auth, so they need a validated create rule.
    // Bot-created invoices still arrive via the Admin SDK (bypasses rules).
    function isValidSlip() {
      let d = request.resource.data;
      return d.type == 'slip'
          && d.status == 'pending'
          && d.tenant is string && d.tenant.size() > 0 && d.tenant.size() <= 60
          && d.total is number && d.total >= 0 && d.total < 100000000
          && d.capturedBy is string && d.capturedBy.size() > 0 && d.capturedBy.size() <= 100
          && d.vendor is string && d.vendor.size() <= 200
          && d.category is string && d.category.size() <= 100
          && d.code is string && d.code.size() <= 20;
    }

    match /wolkInvoices/{invId} {
      allow read: if true;
      allow create: if request.auth != null && isValidSlip();
      // A captured slip can be removed while it is still pending (e.g. a bad
      // snap). Once approved/paid it is locked for the audit trail.
      allow delete: if request.auth != null
          && resource.data.type == 'slip'
          && resource.data.status == 'pending';
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'paidAt', 'paidBy']);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
